# Nevolium production environment template.
# Copy to .env.production, replace every CHANGE_ME value, and keep the resulting file outside version control.

NEVOLIUM_ENV=production
NEVOLIUM_API_PORT=8000
NEVOLIUM_WEB_PORT=5173
NEVOLIUM_REALTIME_PORT=1234
NEVOLIUM_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_INTERNAL_TOKEN
# Core-only secret used to sign short-lived policy capabilities; keep distinct from NEVOLIUM_INTERNAL_TOKEN.
NEVOLIUM_POLICY_SIGNING_KEY=CHANGE_ME_LONG_RANDOM_POLICY_SIGNING_KEY
NEVOLIUM_CORS_ORIGINS=https://nevolium.example.com
NEVOLIUM_AUTH_ENABLED=true
ASSET_MAX_BYTES=26214400
NEVOLIUM_WORKER_EXTRAS=intelligence
# D02 model admission (global PostgreSQL authority, not per Worker)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
NEVOLIUM_MODEL_GLOBAL_CONCURRENCY=8
NEVOLIUM_MODEL_OWNER_CONCURRENCY=2
NEVOLIUM_MODEL_GLOBAL_DAILY_BUDGET_USD=50
NEVOLIUM_MODEL_OWNER_DAILY_BUDGET_USD=10
NEVOLIUM_MODEL_MAX_OUTPUT_TOKENS=4096
NEVOLIUM_NEWS_MODEL_ESTIMATED_COST_USD=0.01

NEVOLIUM_WORKER_MAX_CONCURRENT_ACTIVITIES=16
NEVOLIUM_WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=8
NEVOLIUM_DOCUMENT_MAX_CONCURRENT=1
NEVOLIUM_DOCUMENT_MAX_SOURCE_BYTES=26214400
NEVOLIUM_DOCUMENT_MAX_TEXT_CHARS=1000000
NEVOLIUM_DOCUMENT_PARSE_TIMEOUT_SECONDS=180
# Per-container safety bounds, not a measured capacity promise. Tune with D04 real-engine evidence.
NEVOLIUM_WORKER_CPUS=2.0
NEVOLIUM_WORKER_MEMORY_LIMIT=4g
NEVOLIUM_WORKER_PIDS_LIMIT=256

POSTGRES_USER=nevolium_admin
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=nevolium

NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_LONG_RANDOM_NEO4J_PASSWORD

# The production overlay does not run OpenBao in dev mode. OPENBAO_DEV_TOKEN is intentionally unused.
OPENBAO_DEV_TOKEN=
# Provision a least-privilege Nevolium workload token after initializing/unsealing OpenBao.
OPENBAO_TOKEN=CHANGE_ME_OPENBAO_WORKLOAD_TOKEN

# Bootstrap admin credentials are only for initial Keycloak administration; rotate/remove bootstrap access after setup.
KEYCLOAK_ADMIN=nevolium-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_REALM=nevolium
KEYCLOAK_CLIENT_ID=nevolium-web
KEYCLOAK_PUBLIC_URL=https://auth.nevolium.example.com
KEYCLOAK_ISSUER=https://auth.nevolium.example.com/realms/nevolium

LITELLM_MASTER_KEY=CHANGE_ME_LONG_RANDOM_LITELLM_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=openai/gpt-5.6
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-6
OLLAMA_MODEL=ollama/qwen3:8b
NEVOLIUM_NEWS_MODEL=smart
# Prefer an inexpensive/private route for semantic command classification; paid fallbacks remain behind LiteLLM.
NEVOLIUM_SEMANTIC_ROUTER_MODEL=local-fast
NEVOLIUM_SEMANTIC_ROUTER_ESTIMATED_COST_USD=0.002

SEARXNG_SECRET=CHANGE_ME_LONG_RANDOM_SEARXNG_SECRET
KOKORO_DEFAULT_VOICE=ff_siwis

ACTIVEPIECES_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MINIMUM_KEY
ACTIVEPIECES_JWT_SECRET=CHANGE_ME_LONG_RANDOM_ACTIVEPIECES_JWT

# Self-hosted Langfuse is observability only. Generate distinct production API keys; the same values
# are used for headless project initialization and LiteLLM OTEL authentication.
LANGFUSE_SALT=CHANGE_ME_LONG_RANDOM_LANGFUSE_SALT
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM_LANGFUSE_NEXTAUTH
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
LANGFUSE_INIT_ORG_ID=nevolium
LANGFUSE_INIT_ORG_NAME=Nevolium
LANGFUSE_INIT_PROJECT_ID=nevolium-runtime
LANGFUSE_INIT_PROJECT_NAME=Nevolium Runtime
LANGFUSE_PUBLIC_KEY=lf_pk_CHANGE_ME_LONG_RANDOM_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=lf_sk_CHANGE_ME_LONG_RANDOM_LANGFUSE_SECRET_KEY
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME_LONG_RANDOM_CLICKHOUSE_PASSWORD



TEMPORAL_VERSION=1.31.2
TEMPORAL_ADMINTOOLS_VERSION=1.31.2
TEMPORAL_UI_VERSION=2.53.0

VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Restic. The default local repository is suitable for a restore drill only; production should point to encrypted off-host storage.
RESTIC_REPOSITORY=/repository
RESTIC_PASSWORD=CHANGE_ME_LONG_RANDOM_RESTIC_PASSWORD
RESTIC_LOCAL_PATH=./backups/restic
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
RESTIC_AWS_DEFAULT_REGION=
RESTIC_B2_ACCOUNT_ID=
RESTIC_B2_ACCOUNT_KEY=

# D02: shared heavy-work admission and technical transport retention.
NEVOLIUM_WORK_GLOBAL_CONCURRENCY=4
NEVOLIUM_WORK_OWNER_CONCURRENCY=1
NEVOLIUM_WORK_MAX_PENDING=1000
NEVOLIUM_WORK_OWNER_MAX_PENDING=100
OUTBOX_MAX_PENDING=10000
OUTBOX_PAYLOAD_MAX_BYTES=65536
OUTBOX_RETENTION_DAYS=30
MAINTENANCE_BATCH_SIZE=500
NATS_DOMAIN_MAX_AGE_SECONDS=1209600
NATS_DOMAIN_MAX_BYTES=268435456

# Optional operator engines require explicit immutable assets.
OPENHANDS_AGENT_REPOSITORY=ghcr.io/openhands/agent-server
OPENHANDS_AGENT_TAG=UNCONFIGURED
VLLM_MODEL_REVISION=UNCONFIGURED

# D03: URL-safe random secrets (e.g. 32 random bytes as hex), distinct per identity.
NEVOLIUM_DATABASE_PASSWORD=CHANGE_ME_NEVOLIUM_RUNTIME_DATABASE_PASSWORD
NEVOLIUM_MIGRATOR_PASSWORD=CHANGE_ME_NEVOLIUM_MIGRATOR_DATABASE_PASSWORD
MEM0_DATABASE_PASSWORD=CHANGE_ME_MEM0_DATABASE_PASSWORD
KEYCLOAK_DATABASE_PASSWORD=CHANGE_ME_KEYCLOAK_DATABASE_PASSWORD
TEMPORAL_DATABASE_PASSWORD=CHANGE_ME_TEMPORAL_DATABASE_PASSWORD
LITELLM_DATABASE_PASSWORD=CHANGE_ME_LITELLM_DATABASE_PASSWORD
LANGFUSE_DATABASE_PASSWORD=CHANGE_ME_LANGFUSE_DATABASE_PASSWORD
ACTIVEPIECES_DATABASE_PASSWORD=CHANGE_ME_ACTIVEPIECES_DATABASE_PASSWORD
NEVOLIUM_PUBLIC_API_URL=https://api.nevolium.example.com
# Exact trusted TLS reverse-proxy address or CIDR; do not use a wildcard.
KEYCLOAK_PROXY_TRUSTED_ADDRESSES=CHANGE_ME_PROXY_ADDRESS
NEVOLIUM_MODEL_ASSETS_PATH=./model-assets

NEVOLIUM_OPERATIONS_TOKEN=CHANGE_ME_DISTINCT_OPERATIONS_TOKEN
