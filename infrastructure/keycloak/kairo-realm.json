{
  "realm": "kairo",
  "enabled": true,
  "displayName": "KAIRO",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {"name": "kairo-user", "description": "Authenticated KAIRO user"},
      {"name": "kairo-admin", "description": "KAIRO trust-boundary administrator"}
    ]
  },
  "clients": [
    {
      "clientId": "kairo-web",
      "name": "KAIRO Web + Desktop WebView",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://tauri.localhost/*",
        "tauri://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://tauri.localhost",
        "tauri://localhost"
      ]
    }
  ],
  "users": [
    {
      "username": "kairo-dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "KAIRO",
      "lastName": "Developer",
      "email": "kairo-dev@localhost",
      "realmRoles": ["kairo-user", "kairo-admin"],
      "credentials": [
        {"type": "password", "value": "kairo-dev", "temporary": false}
      ]
    }
  ]
}
